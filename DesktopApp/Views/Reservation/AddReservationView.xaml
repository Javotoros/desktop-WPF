<Window x:Class="DesktopApp.Views.Reservation.AddReservationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Nueva Reserva" Height="600" Width="500" WindowStartupLocation="CenterOwner">

    <Border Background="White" Padding="15" CornerRadius="8" Margin="10" BorderBrush="#DDD" BorderThickness="1">
        <StackPanel Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Center">

            <TextBlock Text="Crear Nueva Reserva" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" TextAlignment="Center"/>

            <!-- Nombre del cliente -->
            <StackPanel Margin="0,5,0,5">
                <TextBlock Text="Buscar Usuario (DNI)" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBox Text="{Binding DNIBusqueda, UpdateSourceTrigger=PropertyChanged}" Height="28" Width="150" />

                <ListBox ItemsSource="{Binding UsuariosFiltrados}" 
                         SelectedItem="{Binding UsuarioSeleccionado}" 
                         DisplayMemberPath="DisplayInfo" 
                         Height="80" Width="200"
                         Background="#FFF0F0F0" Foreground="Black"/>
            </StackPanel>

            <!-- Habitación -->
            <TextBlock Text="Habitaciones" FontWeight="SemiBold" Margin="0,5,0,2"/>
            <ListBox x:Name="lbHabitaciones" Height="80" Width="200" SelectionMode="Extended" DisplayMemberPath="numRoom" 
                     ItemsSource="{Binding Habitaciones}"
                     Background="#FFF0F0F0" Foreground="Black"/>

            <!-- Fecha de Entrada y Salida -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Fecha de Entrada" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <DatePicker SelectedDate="{Binding CheckIn}" Height="28" Width="120"/>
                </StackPanel>

                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="Fecha de Salida" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <DatePicker SelectedDate="{Binding CheckOut}" Height="28" Width="120"/>
                </StackPanel>
            </StackPanel>

            <!-- Estado -->
            <TextBlock Text="Estado" FontWeight="SemiBold" Margin="0,10,0,2"/>
            <ComboBox SelectedItem="{Binding SelectedStatus}" Height="28" Width="150">
                <ComboBoxItem Content="confirmada" IsSelected="True"/>
                <ComboBoxItem Content="cancelada"/>
                <ComboBoxItem Content="checkin"/>
                <ComboBoxItem Content="checkout"/>
            </ComboBox>

            <!-- Botones -->
            <StackPanel Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Center">
                <Button Content="Crear Reserva" Width="150" Height="30" Command="{Binding NuevaReservaCommand}"/>
                <Button Content="Volver" Width="100" Height="30"  Margin="10,0,0,0" Command="{Binding VolverCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
