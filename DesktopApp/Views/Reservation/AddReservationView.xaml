<UserControl x:Class="DesktopApp.Views.Reservation.AddReservationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="600">

    <Border Background="White" Padding="20" CornerRadius="10" Margin="10" BorderBrush="#DDD" BorderThickness="1">
        <StackPanel Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Center" Width="400" Height="500">
            <TextBlock Text="Crear Nueva Reserva" FontSize="24" FontWeight="Bold" Margin="0,0,0,10" TextAlignment="Center"/>

            <!-- Nombre del cliente -->
            <StackPanel>
                <TextBlock Text="Buscar Usuario (DNI)" FontWeight="SemiBold" Margin="0,5,0,2"/>
                <TextBox Text="{Binding DNIBusqueda, UpdateSourceTrigger=PropertyChanged}" Height="30" Width="190" />

                <ListBox ItemsSource="{Binding UsuariosFiltrados}" 
                 SelectedItem="{Binding UsuarioSeleccionado}" 
                 DisplayMemberPath="DisplayInfo" 
                 Height="100"
                 Background="#FFF0F0F0" Foreground="Black"/>
            </StackPanel>
            <TextBlock x:Name="lblClienteInfo" FontSize="12" Foreground="Gray" />

            <!-- Habitación -->
            <TextBlock Text="Habitaciones" FontWeight="SemiBold" Margin="0,5,0,2"/>
            <ListBox x:Name="lbHabitaciones" Height="100" SelectionMode="Extended" DisplayMemberPath="numRoom" 
                     ItemsSource="{Binding Habitaciones}"
                     Background="#FFF0F0F0" Foreground="Black"/>

            <!-- Fecha de Entrada -->
            <TextBlock Text="Fecha de Entrada" FontWeight="SemiBold" Margin="0,10,0,2"/>
            <DatePicker SelectedDate="{Binding CheckIn}" Height="30"/>

            <!-- Fecha de Salida -->
            <TextBlock Text="Fecha de Salida" FontWeight="SemiBold" Margin="0,10,0,2"/>
            <DatePicker SelectedDate="{Binding CheckOut}" Height="30"/>

            <!-- Estado -->
            <TextBlock Text="Estado" FontWeight="SemiBold" Margin="0,10,0,2"/>
            <ComboBox SelectedItem="{Binding SelectedStatus}" Height="30">
                <ComboBoxItem Content="confirmada" IsSelected="True"/>
                <ComboBoxItem Content="cancelada"/>
                <ComboBoxItem Content="checkin"/>
                <ComboBoxItem Content="checkout"/>
            </ComboBox>
            <!-- Botones -->
            <StackPanel Orientation="Horizontal">
                <Button Content="Crear Reserva" Width="200" Height="35" Margin="0,20,0,0" Click="BtnCrearReserva_Click"/>
                <Button Content="Volver" Height="35" Width="150" Margin="50,20,0,0"  Command="{Binding VolverCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
