<UserControl x:Class="DesktopApp.Views.ListRoomsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DesktopApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" >
    <Grid>
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,10" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource IconButtonStyle}" Click="Save_Click" >
                        <Path Fill="{StaticResource PrimaryBrush}"
                            Width="18" Height="18" Stretch="Uniform"
                            Data="{StaticResource IcoAdd}"/>
                    </Button>

                </StackPanel>
                <ListBox Grid.Row="1"  Padding="20" ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,12,12"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}"
                                Width="390"
                                Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="170"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                

                                    <Grid Grid.Row="0" ClipToBounds="True">
                                        <Image Stretch="Uniform" 
                                               Source="{Binding image, Converter={StaticResource ApiImageConverter}}"/>
                                        <TextBlock Text="Sin foto"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Opacity="0.7">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding image}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding image.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Border Background="#F2FFFFFF"
                                            CornerRadius="10"
                                            Padding="10,4"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="12">
                                            <TextBlock Text="{Binding numRoom}" FontWeight="SemiBold"/>
                                        </Border>

                                        <Border CornerRadius="10"
                                            Padding="10,4"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="12"
                                            Background="{StaticResource AccentBrush}">

                                            <TextBlock Text="{Binding availability}"/>
                                        </Border>
                                    </Grid>
                                    <Grid Grid.Row="1" >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                    Text="{Binding roomType}"
                                                    FontSize="18"
                                                    FontWeight="SemiBold"/>
                                            <TextBlock
                                                    Grid.Column="1"
                                                    Text="{Binding ReviewCount, StringFormat=⭐ {0} reseñas}"
                                                    FontSize="18"
                                                    FontWeight="SemiBold"/>
                                        </Grid>
                                        <TextBlock Grid.Row="1"
                                                Text="{Binding description}"
                                                Margin="0,8,0,0"
                                                Opacity="0.8"
                                                TextTrimming="CharacterEllipsis"/>
                                        <Grid Grid.Row="2" Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding numFloor, StringFormat=Piso {0}}" />

                                            <TextBlock Grid.Column="1"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding maxOccupancy, StringFormat=Máx. {0} persona(s)}"/>
                                        </Grid>
                                        
                                        <Grid Grid.Row="3" Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding pricePerNight, StringFormat=€ {0:0}}"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0AA36C"/>
                                                <TextBlock Text=" / noche"
                                                       Margin="6,5,0,0"
                                                       Opacity="0.7"/>
                                            </StackPanel>

                                            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Click="Update_Click"
                                                    CommandParameter="{Binding}"
                                                    Margin="0 0 20 0">
                                                <Path Fill="{StaticResource UpdateBrush}"
                                                     Width="18" Height="18" Stretch="Uniform"
                                                     Data="{StaticResource IcoUpdate}"/>
                                            </Button>

                                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" 
                                                    Command="{Binding DataContext.DeleteRoomCommand, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                                <Path Fill="{StaticResource CancelBrush}"
                                                      Width="18" Height="18" Stretch="Uniform"
                                                      Data="{StaticResource IcoDelete}"/>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!--<DataGrid Grid.Row="1" Style="{StaticResource RoomsDataGridStyle}" ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NºHab" Binding="{Binding numRoom}" Width="70"/>
                        <DataGridTextColumn Header="Planta" Binding="{Binding numFloor}" Width="80"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding roomType}" Width="140"/>
                        <DataGridTextColumn Header="Precio/noche" Binding="{Binding pricePerNight, StringFormat={}{0:0.00} €}" Width="120"/>
                        <DataGridTextColumn Header="Ocupación máx." Binding="{Binding maxOccupancy}" Width="120"/>
                        <DataGridTextColumn Header="Disponible" Binding="{Binding availability}" Width="100"/>
                        <DataGridTextColumn Header="Descripción" Binding="{Binding description}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>-->
            </Grid>
        </Border>
    </Grid>
</UserControl>
