<UserControl x:Class="DesktopApp.Views.ListRoomsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Border Style="{StaticResource CardStyle}"
        HorizontalAlignment="Center"
        Padding="0"
        Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,10"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Style="{StaticResource IconButtonStyle}" Click="Save_Click">
                        <Path Fill="{StaticResource PrimaryBrush}"
                              Width="18" Height="18" Stretch="Uniform"
                              Data="{StaticResource IcoAdd}"/>
                    </Button>
                </StackPanel>

                <ListBox Grid.Row="1"
                         Padding="20"
                         ItemsSource="{Binding Rooms}"
                         SelectedItem="{Binding SelectedRoom}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,12,12"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}"
                                    Padding="0"
                                    Margin="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="170"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    
                                    <Grid Grid.Row="0" ClipToBounds="True">
                                        <Image Stretch="UniformToFill"
                                               Source="{Binding image, Converter={StaticResource ApiImageConverter}}"/>

                                        <TextBlock Text="Sin foto"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"
                                                   Opacity="0.7">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding image}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding image.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Border Background="#F2FFFFFF"
                                                CornerRadius="10"
                                                Padding="10,4"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="12">
                                            <TextBlock Text="{Binding numRoom}" FontWeight="SemiBold"/>
                                        </Border>

                                        <Border CornerRadius="10"
                                                Padding="10,4"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="12"
                                                Background="{StaticResource AccentBrush}">
                                            <TextBlock Text="{Binding availability}"/>
                                        </Border>
                                    </Grid>

                                    
                                    <Grid Grid.Row="1" >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="170"/>
                                        </Grid.ColumnDefinitions>

                                       
                                        <StackPanel Grid.Column="0" >
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding roomType}"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>

                                                
                                            </Grid>

                                            <TextBlock Text="{Binding description}"
                                                       Margin="0,8,0,0"
                                                       Opacity="0.8"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="48"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border CornerRadius="50" Width="100">
                                                <Button Grid.Column="1"
                                                    Background="{StaticResource PrimaryBrush}"                                                   
                                                    Click="Reviews_Click"
                                                    CommandParameter="{Binding}"
                                                    Margin="0 30 0 0">
                                                    <TextBlock Text="Reviews" FontWeight="SemiBold"/>
                                                </Button>
                                            </Border>
                                        </StackPanel>

                                        
                                        <StackPanel Grid.Column="2">
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Piso:" Opacity="0.7"/>
                                                <TextBlock Grid.Column="1"
                                                           HorizontalAlignment="Right"
                                                           Text="{Binding numFloor}"/>
                                            </Grid>

                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Máx:" Opacity="0.7"/>
                                                <TextBlock Grid.Column="1"
                                                           HorizontalAlignment="Right"
                                                           Text="{Binding maxOccupancy, StringFormat={}{0} pers.}"/>
                                            </Grid>

                                            <Border Margin="0,10,0,0"
                                                    CornerRadius="10"
                                                    Padding="10,6"
                                                    Background="#0F000000">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding pricePerNight, StringFormat=€ {0:0}}"
                                                               FontSize="18"
                                                               FontWeight="SemiBold"
                                                               Foreground="#0AA36C"/>
                                                    <TextBlock Text=" / noche" Margin="6,4,0,0" Opacity="0.7"/>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,10,0,0">
                                                <Button Style="{StaticResource IconButtonStyle}"
                                                        Click="Update_Click"
                                                        CommandParameter="{Binding}"
                                                        Margin="0,0,10,0">
                                                    <Path Fill="{StaticResource UpdateBrush}"
                                                          Width="18" Height="18" Stretch="Uniform"
                                                          Data="{StaticResource IcoUpdate}"/>
                                                </Button>

                                                <Button Style="{StaticResource IconButtonStyle}"
                                                        Command="{Binding DataContext.DeleteRoomCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Fill="{StaticResource CancelBrush}"
                                                          Width="18" Height="18" Stretch="Uniform"
                                                          Data="{StaticResource IcoDelete}"/>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>