<Window x:Class="DesktopApp.Views.FormRoomsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DesktopApp.Views"
        mc:Ignorable="d"
        Title="FormRoomsView" Height="720" Width="1200" MinWidth="820" MinHeight="720">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ====== Header ====== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Crear Nueva Habitación" FontSize="34" FontWeight="Bold"/>
                <TextBlock Text="Complete los datos para registrar una nueva habitación en el sistema"
                            Margin="0,6,0,0"/>
            </StackPanel>

            <Button Grid.Column="2"
                    Style="{StaticResource SecondaryButton }"
                    Command="{Binding SaveCommand}"
                    Margin="10">
                <Button.Template >
                    <ControlTemplate TargetType="Button" >
                        <Border CornerRadius="25" Background="{StaticResource OkBrush}" Padding="10">
                            <TextBlock Text="Guardar" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Grid.Column="3"
                    Style="{StaticResource SecondaryButton }"
                    Command="{Binding SaveCommand}"
                    Margin="10">
                <Button.Template >
                    <ControlTemplate TargetType="Button" >
                        <Border CornerRadius="25" Background="{StaticResource UpdateBrush}" Padding="10">
                            <TextBlock Text="Limpiar" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Grid.Column="4  "
                    Style="{StaticResource SecondaryButton }"
                    Command="{Binding SaveCommand}"
                    Margin="10">
                <Button.Template >
                    <ControlTemplate TargetType="Button" >
                        <Border CornerRadius="25" Background="{StaticResource CancelBrush}" Padding="10">
                            <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- ====== Content ====== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Row 1: Basic + Price -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Información Básica -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Información Básica" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Número de Habitación " Style="{StaticResource Label}"/>
                                    <TextBlock MinHeight="40"
                                               Padding="10"
                                               VerticalAlignment="Center"
                                               Background="#FFF3F4F6"
                                             Text="{Binding NextRoom}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Piso" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="numFloorText" Style="{StaticResource InputTextBox}"
                                             Text="{Binding NewFloor, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Tipo de Habitación" Style="{StaticResource Label}"/>
                            <ComboBox MinHeight="40"
                                      BorderThickness="1"
                                      Padding="10,6"
                                      ItemsSource="{Binding RoomTypes}"
                                      SelectedItem="{Binding SelectedRoomType}"
                                      />

                            <TextBlock Text="Descripción" Style="{StaticResource Label}" Margin="0,14,0,0"/>
                            <TextBox Style="{StaticResource InputTextBox}"
                                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="110"
                                     VerticalContentAlignment="Top"/>
                        </StackPanel>
                    </Border>

                    <!-- Precio y Disponibilidad -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Precio y Disponibilidad" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                            <TextBlock Text="Precio por Noche (€)" Style="{StaticResource Label}"/>
                            <TextBox Style="{StaticResource InputTextBox}"
                                     Text="{Binding PricePerNight, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

                            <TextBlock Text="Capacidad Máxima (personas)" Style="{StaticResource Label}" Margin="0,14,0,0"/>
                            <DockPanel>
                                <TextBox Style="{StaticResource InputTextBox}"
                                         Text="{Binding MaxOccupancy, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                         DockPanel.Dock="Left"/>
                            </DockPanel>

                            <TextBlock Text="Disponibilidad" Style="{StaticResource Label}" Margin="0,14,0,0"/>
                            <ComboBox MinHeight="40"
                                      BorderThickness="1"
                                      Padding="10,6"
                                      SelectedItem="{Binding SelectedAvailability}"
                                      ItemsSource="{Binding AvailabilityOptions}"/>

                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 2: Imágenes + Reseñas -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Imágenes -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Imágenes de la Habitación" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Style="{StaticResource InputTextBox}"
                                         Text="{Binding ImageUrlDraft, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Pega una URL válida (https://...)"
                                         />
                                <Button Grid.Column="2"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="＋ Agregar"
                                        Command="{Binding AddImageCommand}"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Images}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFF9FAFB" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                                            <DockPanel>
                                                <TextBlock Text="{Binding}" Foreground="#FF374151" TextTrimming="CharacterEllipsis" />
                                                <Button DockPanel.Dock="Right"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="10,6"
                                                        Content="Eliminar"
                                                        Command="{Binding DataContext.RemoveImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Tip: aquí puedes mostrar miniaturas si luego descargas la imagen."
                                       Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Reseñas -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Reseñas" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Style="{StaticResource InputTextBox}"
                                         Text="{Binding ReviewDraft, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="70"
                                         VerticalContentAlignment="Top"
                                         />
                                <Button Grid.Column="2"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="＋ Agregar"
                                        Command="{Binding AddReviewCommand}"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Reviews}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFF9FAFB" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                                            <DockPanel>
                                                <TextBlock Text="{Binding}" Foreground="#FF374151" TextWrapping="Wrap" Width="360"/>
                                                <Button DockPanel.Dock="Right"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="10,6"
                                                        Content="Eliminar"
                                                        Command="{Binding DataContext.RemoveReviewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
