<UserControl x:Class="DesktopApp.Controls.navControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DesktopApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border x:Name="SidebarContainer"
         Width="80"
         Padding="8"
         Background="{StaticResource BackgroundBrush2}">

            <!-- Hover: anima el mismo Border -->
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width"
                                                  To="250"
                                                  Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>

                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width"
                                                  To="80"
                                                  Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="120"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Image Grid.Row="0"
                Source="/Resources/Images/IconHotel.png"
                Stretch="Uniform"
                Height="250"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

                <ListBox x:Name="MainMenu"
         Grid.Row="1"
         Style="{StaticResource SidebarListBoxStyle}"
         ItemContainerStyle="{StaticResource SidebarItemStyle}"
         SelectionChanged="MainMenu_SelectionChanged">

                    <ListBoxItem Tag="dashboard" Margin="10 10">
                        <StackPanel Orientation="Horizontal">
                            <Path Fill="{StaticResource PrimaryBrush}"
                           Width="18" Height="18" Stretch="Uniform"
                           Data="{StaticResource IcoDashboard}"/>
                            <TextBlock Text="Dashboard"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SidebarTextStyle}"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Tag="users" Margin="10 10">
                        <StackPanel Orientation="Horizontal">
                            <Path Fill="{StaticResource PrimaryBrush}"
                           Width="18" Height="18" Stretch="Uniform"
                           Data="{StaticResource IcoUsers}"/>
                            <TextBlock Text="Usuarios"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SidebarTextStyle}"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Tag="reservas" Margin="10 10">
                        <StackPanel Orientation="Horizontal">
                            <Path Fill="{StaticResource PrimaryBrush}"
                           Width="18" Height="18" Stretch="Uniform"
                           Data="{StaticResource IcoReservations}"/>
                            <TextBlock Text="Reservas"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SidebarTextStyle}"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Tag="rooms" Margin=" 10 10">
                        <StackPanel Orientation="Horizontal">
                            <Path Fill="{StaticResource PrimaryBrush}"
                           Width="18" Height="18" Stretch="Uniform"
                           Data="{StaticResource IcoRooms}"/>
                            <TextBlock Text="Habitaciones"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SidebarTextStyle}"/>
                        </StackPanel>
                    </ListBoxItem>

                </ListBox>

                <!-- MENÚ INFERIOR -->
                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <Separator Opacity="0.25"/>

                    <ListBox Style="{StaticResource SidebarListBoxStyle}"
                      ItemContainerStyle="{StaticResource SidebarItemStyle}">

                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="{StaticResource PrimaryBrush}"
                               Width="18" Height="18" Stretch="Uniform"
                               Data="{StaticResource IcoHelp}"/>
                                <TextBlock Text="Ayuda"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SidebarTextStyle}"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="{StaticResource PrimaryBrush}"
                               Width="18" Height="18" Stretch="Uniform"
                               Data="{StaticResource IcoPower}"/>
                                <TextBlock Text="Salir"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SidebarTextStyle}"/>
                            </StackPanel>
                        </ListBoxItem>

                    </ListBox>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</UserControl>
