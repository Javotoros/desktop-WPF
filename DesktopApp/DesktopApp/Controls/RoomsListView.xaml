<UserControl x:Class="DesktopApp.Controls.RoomsListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DesktopApp.Views"
             mc:Ignorable="d" 
             Height="Auto" Width="Auto">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Filters -->
            <RowDefinition Height="*"/>
            <!-- Main -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- =======================
             HEADER / ACCIONES
        ======================== -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Habitaciones" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Listado y filtros (tipo, disponibilidad y rango de precio)" 
                               Foreground="#BFFFFFFF" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Buscar"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SearchCommand}"/>

                    <Button Content="Limpiar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ClearFiltersCommand}"/>

                    <Button Content="Nueva"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding AddRoomCommand}"/>

                    <Button Content="Editar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding EditSelectedRoomCommand}"/>

                    <Button Content="Eliminar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding DeleteSelectedRoomCommand}"/>

                    <Button Content="Ver reservas"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ViewReservationsCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- =======================
             FILTROS
        ======================== -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Búsqueda libre (extra) -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Buscar (nº habitación / descripción)" Style="{StaticResource LabelStyle}"/>
                    <TextBox Style="{StaticResource InputStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Tipo -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Tipo" Style="{StaticResource LabelStyle}"/>
                    <ComboBox Style="{StaticResource InputStyle}"
                              ItemsSource="{Binding RoomTypes}"
                              SelectedItem="{Binding SelectedRoomType}"
                              VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Disponibilidad -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Disponibilidad" Style="{StaticResource LabelStyle}"/>
                    <ComboBox Style="{StaticResource InputStyle}"
                              ItemsSource="{Binding AvailabilityOptions}"
                              SelectedItem="{Binding SelectedAvailability}"
                              VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Precio mínimo -->
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Precio mín." Style="{StaticResource LabelStyle}"/>
                    <TextBox Style="{StaticResource InputStyle}"
                             Text="{Binding MinPrice, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Precio máximo -->
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Precio máx." Style="{StaticResource LabelStyle}"/>
                    <TextBox Style="{StaticResource InputStyle}"
                             Text="{Binding MaxPrice, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Indicador -->
                <StackPanel Grid.Column="5" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding FilterSummary}"
                               Foreground="#BFFFFFFF" FontSize="12"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- =======================
             MAIN: GRID + DETALLE
        ======================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <!-- Tabla -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="{Binding ResultsTitle}"
                                   Foreground="White" FontWeight="SemiBold" FontSize="14"
                                   DockPanel.Dock="Left"/>
                        <TextBlock Text="{Binding ResultsCountText}"
                                   Foreground="#BFFFFFFF" FontSize="12"
                                   DockPanel.Dock="Right"/>
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              Style="{StaticResource RoomsDataGridStyle}"
                              ItemsSource="{Binding Rooms}"
                              SelectedItem="{Binding SelectedRoom}">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Nº"
                                                Binding="{Binding numRoom}"
                                                Width="70"/>

                            <DataGridTextColumn Header="Planta"
                                                Binding="{Binding numFloor}"
                                                Width="80"/>

                            <DataGridTextColumn Header="Tipo"
                                                Binding="{Binding roomType}"
                                                Width="140"/>

                            <DataGridTextColumn Header="Precio/noche"
                                                Binding="{Binding pricePerNight, StringFormat={}{0:0.00} €}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Ocupación máx."
                                                Binding="{Binding maxOccupancy}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Disponible"
                                                Binding="{Binding availability}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Reviews"
                                                Binding="{Binding reviews}"
                                                Width="90"/>

                            <DataGridTextColumn Header="Descripción"
                                                Binding="{Binding description}"
                                                Width="*"/>

                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </Border>

            <!-- Detalle rápido -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="200"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Detalle de habitación"
                               Foreground="White" FontWeight="SemiBold" FontSize="14"
                               Margin="0,0,0,10"/>

                    <!-- Imagen -->
                    <Border Grid.Row="1" CornerRadius="14" Background="#12FFFFFF" Padding="8">
                        <Image Source="{Binding SelectedRoom.image}"
                               Stretch="UniformToFill"/>
                    </Border>

                    <!-- Chips de info -->
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="{Binding SelectedRoom.numRoom, StringFormat=Habitación {0}}"
                                   Foreground="White" FontSize="16" FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding SelectedRoom.roomType, StringFormat=Tipo: {0}}"
                                   Foreground="#BFFFFFFF" Margin="0,6,0,0"/>

                        <TextBlock Text="{Binding SelectedRoom.pricePerNight, StringFormat=Precio: {0:0.00} € / noche}"
                                   Foreground="#BFFFFFFF" Margin="0,2,0,0"/>

                        <TextBlock Text="{Binding SelectedRoom.maxOccupancy, StringFormat=Ocupación máx.: {0}}"
                                   Foreground="#BFFFFFFF" Margin="0,2,0,0"/>

                        <TextBlock Text="{Binding SelectedRoom.availability, StringFormat=Disponible: {0}}"
                                   Foreground="#BFFFFFFF" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Descripción -->
                    <ScrollViewer Grid.Row="3" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding SelectedRoom.description}"
                                   Foreground="#DFFFFFFF" TextWrapping="Wrap"/>
                    </ScrollViewer>

                </Grid>
            </Border>
        </Grid>

        <!-- =======================
             FOOTER / ESTADO
        ======================== -->
        <Border Grid.Row="3" Background="Transparent" Padding="2">
            <DockPanel>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#BFFFFFFF"
                           DockPanel.Dock="Left"/>

                <ProgressBar Width="160" Height="6"
                             IsIndeterminate="{Binding IsLoading}"
                             DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>

    </Grid>
</UserControl>
