<Window x:Class="DesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DesktopApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>

        <!-- Estilo del Menu -->
        <Style TargetType="Menu">
            <Setter Property="Background" Value="#2D2F36"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Estilo MenuItem principal -->
        <Style TargetType="MenuItem">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Hover -->
        <Style TargetType="MenuItem" x:Key="SubMenuItemStyle">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
        </Style>
    </Window.Resources>
    <Grid>
        <!-- COLUMNAS PRINCIPALES -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- FILAS PRINCIPALES -->
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- LOGO -->
        <Border Grid.Row="0" Grid.Column="0"
            Background="#2D2F36"
            Padding="10">
            <Image Source="/Resources/Images/logo.png"
               Height="50"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"/>
        </Border>

        <!-- MENÚ -->
        <Menu Grid.Row="1" Grid.Column="0"
          Background="#2D2F36"
          Foreground="White">

            <MenuItem Header="Gestión de Empleados">
                <MenuItem Header="Nuevo"/>
                <MenuItem Header="Listar"/>
            </MenuItem>

            <MenuItem Header="Gestión de Habitaciones">
                <MenuItem Header="Nuevo"/>
                <MenuItem Header="Listar"/>
            </MenuItem>

            <MenuItem Header="Gestión de Reservas">
                <MenuItem Header="Nuevo"/>
                <MenuItem Header="Listar"/>
            </MenuItem>
        </Menu>

        <!-- CABECERA USUARIO -->
        <Border Grid.Row="0" Grid.Column="1"
            Background="#F5F5F5"
            Padding="15">
            <DockPanel LastChildFill="False">

                <!-- IMAGEN USUARIO -->
                <Ellipse DockPanel.Dock="Right"
                     Width="45"
                     Height="45"
                     Margin="10,0,0,0">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="/Assets/user.png"/>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- TEXTO USUARIO -->
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Center">
                    <TextBlock Text="Juan Pérez"
                        FontWeight="Bold"
                        FontSize="14"/>
                    <TextBlock Text="Administrador"
                        FontSize="11"
                        Foreground="Gray"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                    <TextBlock Text="Hotel Pere Maria"
                        FontWeight="Bold"
                        FontSize="40"/>
                </StackPanel>

            </DockPanel>
        </Border>
        
        <!--CONTENIDO PRINCIPAL -->
        <Grid Grid.Row="1" Grid.Column="1"
          Background="AntiqueWhite">
            <TextBlock Text="Contenido principal"
                   FontSize="24"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
        </Grid>

    </Grid>
</Window>
